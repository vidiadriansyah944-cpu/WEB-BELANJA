# ============================================================
#  TokoKita - konfigurasi lingkungan
#  Salin file ini menjadi .env lalu isi nilainya.
# ============================================================

APP_NAME="TokoKita"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

# Kunci rahasia untuk enkripsi token Google (WAJIB diganti).
# Buat dengan: php bin/key.php
APP_KEY=

# ------------------------------------------------------------
# Database (SQLite, tanpa setup server)
# ------------------------------------------------------------
DB_DRIVER=sqlite
DB_PATH=storage/toko.sqlite

# ------------------------------------------------------------
# Toko
# ------------------------------------------------------------
STORE_CURRENCY=IDR
STORE_TAX_PERCENT=11
STORE_SHIPPING_FLAT=18000
STORE_FREE_SHIPPING_MIN=350000

# Rekening tujuan transfer manual
BANK_NAME="Bank Mandiri"
BANK_ACCOUNT_NO="1370012345678"
BANK_ACCOUNT_HOLDER="TokoKita Digital"

# ------------------------------------------------------------
# Admin
# ------------------------------------------------------------
ADMIN_EMAIL=admin@tokokita.test
ADMIN_PASSWORD=admin12345

# ------------------------------------------------------------
# Google Cloud (Gmail API + Drive API)
# Buat di https://console.cloud.google.com/apis/credentials
# Jenis OAuth Client: "Web application"
# Authorized redirect URI: http://localhost:8000/google/callback
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/google/callback
GOOGLE_DRIVE_FOLDER="TokoKita/Invoice"
GOOGLE_OAUTH_SCOPES="https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/drive.file https://www.googleapis.com/auth/userinfo.email"
GOOGLE_EMAIL_SENDER_NAME="TokoKita"
GOOGLE_REPLY_TO=

# Kirim email otomatis setiap transaksi berhasil
GOOGLE_AUTO_SEND_RECEIPT=true
# Unggah invoice PDF ke Drive setiap transaksi berhasil
GOOGLE_AUTO_UPLOAD_INVOICE=true
